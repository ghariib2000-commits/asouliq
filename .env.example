# انسخ هذا الملف إلى .env محليًا واملأ القيم. لا ترفع .env إلى GitHub.
TELEGRAM_TOKEN=

# مسار قاعدة البيانات. على Railway استخدم مسار الـVolume، مثال: /data/asouliq.db
DATABASE_PATH=asouliq.db

# معرّف Telegram للمالك (يسمح بأمر /backup). اتركه فاضي لتعطيل الأمر.
OWNER_TELEGRAM_ID=

# اختياري: معامل السوق المصري في حساب سعر جرام الذهب
GOLD_MARKET_PREMIUM=1.018

# اختياري: إعدادات الشبكة والتخزين المؤقت
HTTP_TIMEOUT_SECONDS=8
PRICE_CACHE_TTL_SECONDS=60
LOG_LEVEL=INFO
